# Local dev uses SQLite. Docker overrides this with Postgres.
DATABASE_URL=sqlite:///agent.db
CHECKPOINT_DB=checkpoints.db
# Use 32+ random characters
JWT_SECRET=change-me-to-a-32-byte-secret!!!
# fake | groq | gemini  (fake needs no key; gemini key: aistudio.google.com)
LLM_PROVIDER=fake
LLM_API_KEY=
# Optional: override the provider default model (gemini-3.5-flash-lite / openai/gpt-oss-20b)
LLM_MODEL=
# Demo login buttons in the UI (turn off in production)
DEMO_MODE=true
# Latency limits (seconds): one LLM call / all calls of one message
LLM_TIMEOUT_S=2.0
LLM_BUDGET_S=3.5
# Timezone of cab times and cut-offs (the server may run in UTC)
APP_TZ=Asia/Kolkata
