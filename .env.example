# Local dev uses SQLite. Docker overrides this with Postgres.
DATABASE_URL=sqlite:///agent.db
CHECKPOINT_DB=checkpoints.db
# Use 32+ random characters
JWT_SECRET=change-me-to-a-32-byte-secret!!!
# fake | groq  (fake needs no key)
LLM_PROVIDER=fake
LLM_API_KEY=
# Demo login buttons in the UI (turn off in production)
DEMO_MODE=true
